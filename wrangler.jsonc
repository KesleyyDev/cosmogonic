{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cosmogonic",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "cosmogonic.space", "custom_domain": true },
    { "pattern": "www.cosmogonic.space", "custom_domain": true }
  ]
}
